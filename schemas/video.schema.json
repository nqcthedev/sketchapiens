{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sketchapiens/video.schema.json",
  "title": "Sketchapiens video manifest",
  "description": "Một video = một video.yaml. SỬA 07/08/2026: tách ID sáng tạo khỏi ID thực thi, và đổi approved/published từ BẢN SAO sang CON TRỎ. Xem governance/MIGRATION_LOG.md.",
  "type": "object",
  "required": ["id", "slug", "status", "language", "created", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SKA-[0-9]{3,4}(-[a-z0-9-]+)?$",
      "description": "ID sáng tạo BẤT BIẾN. Không mã hoá ý nghĩa thay đổi được vào ID."
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "legacy_id": { "type": ["string", "null"], "description": "Tên cũ, vd 'V17'. Hai thư mục cùng số 17 thì mỗi cái một id mới, cùng legacy_id." },
    "legacy_paths": { "type": "array", "items": { "type": "string" }, "description": "Thư mục cũ. GHI LẠI, không di chuyển." },
    "status": {
      "type": "string",
      "description": "Trạng thái SÁNG TẠO. Không phải trạng thái chạy máy — cái đó ở runs[].status.",
      "enum": ["idea","packaging","research","drafting","review","revision","approved","production","ready_to_publish","published","measured","postmortem_complete","abandoned","archived"]
    },
    "language": { "type": "string", "enum": ["en"] },
    "created": { "type": "string", "format": "date" },
    "source": { "type": "string", "enum": ["new", "migrated"] },

    "title": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "current": { "type": ["string", "null"] },
        "rejected": { "type": "array", "items": { "type": "object", "required": ["text","reason"], "additionalProperties": false, "properties": { "text": {"type":"string"}, "reason": {"type":"string"} } } }
      }
    },

    "thumbnail": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "concept": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "image_path": { "type": ["string", "null"] },
        "stage": { "type": "string", "enum": ["none", "concept_only", "image_built"] }
      }
    },

    "script": {
      "type": "object", "additionalProperties": false,
      "description": "Version BẤT BIẾN + con trỏ đổi được. KHÔNG dùng tên file kiểu FINAL làm lịch sử.",
      "properties": {
        "versions": {
          "type": "array",
          "description": "Mỗi mục là một file trong script/versions/. ĐÃ TẠO THÌ KHÔNG SỬA.",
          "items": {
            "type": "object", "required": ["version", "file", "reason"], "additionalProperties": false,
            "properties": {
              "version": { "type": "string", "pattern": "^v[0-9]{3}$" },
              "file": { "type": "string" },
              "reason": { "type": "string" },
              "words": { "type": ["integer", "null"] },
              "created": { "type": ["string", "null"] },
              "from_review": { "type": ["string", "null"], "description": "review_id sinh ra version này" }
            }
          }
        },
        "refs": {
          "type": "object", "additionalProperties": false,
          "description": "Con trỏ ĐỔI ĐƯỢC. File version thì không.",
          "properties": {
            "current":   { "$ref": "#/$defs/ref" },
            "approved":  { "$ref": "#/$defs/ref" },
            "published": { "$ref": "#/$defs/ref" }
          }
        }
      }
    },

    "reviews": {
      "type": "array",
      "items": {
        "type": "object", "required": ["review_id", "on_version", "kind"], "additionalProperties": false,
        "properties": {
          "review_id": { "type": "string", "pattern": "^REV-[0-9]{8}-[0-9]{3}$" },
          "on_version": { "type": "string", "pattern": "^v[0-9]{3}$" },
          "kind": { "type": "string", "enum": ["internal_agents", "external_listener", "machine_qa"] },
          "files": { "type": "array", "items": { "type": "string" } },
          "triaged_by": { "type": ["string", "null"], "description": "Phải là NGƯỜI. Agent không tự điền." },
          "triaged_at": { "type": ["string", "null"] }
        }
      }
    },

    "evidence": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ledger": { "type": ["string", "null"] },
        "locked_on_version": { "type": ["string", "null"], "description": "Khoá cho version nào. Version mới đổi câu mang số liệu → claim thành STALE." },
        "stale_claims": { "type": ["integer", "null"] },
        "unverified_count": { "type": ["integer", "null"] },
        "overreach_ge2": { "type": ["integer", "null"] }
      }
    },

    "runs": {
      "type": "array",
      "description": "Lần chạy máy. TÁCH HẲN khỏi status của video: một run hỏng KHÔNG làm video đổi trạng thái.",
      "items": {
        "type": "object", "required": ["run_id", "kind", "status"], "additionalProperties": false,
        "properties": {
          "run_id": { "type": "string", "pattern": "^(IMG|TTS|RND)-[0-9]{8}-[0-9]{3}$" },
          "kind": { "type": "string", "enum": ["image", "tts", "render"] },
          "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"] },
          "on_version": { "type": ["string", "null"], "description": "Chạy từ version kịch bản nào" },
          "provider": { "type": ["string", "null"] },
          "settings": { "type": ["object", "null"], "additionalProperties": true },
          "expected_count": { "type": ["integer", "null"] },
          "produced_count": { "type": ["integer", "null"] },
          "missing_indices": { "type": "array", "items": { "type": "integer" } },
          "counts_match": { "type": ["boolean", "null"], "description": "V12/V14/V15 lệch số mà không ai biết. Trường này để không lặp lại." },
          "output_dir": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"] },
          "finished_at": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },

    "publish": {
      "type": "object", "additionalProperties": false,
      "description": "CHỈ NGƯỜI điền. Trống = not_published. KHÔNG suy ra.",
      "properties": {
        "state": { "type": "string", "enum": ["not_published", "published", "unlisted", "private", "unknown"] },
        "url": { "type": ["string", "null"] },
        "published_at": { "type": ["string", "null"] },
        "actual_title": { "type": ["string", "null"] },
        "actual_thumbnail": { "type": ["string", "null"] },
        "duration_seconds": { "type": ["integer", "null"] },
        "from_render_run": { "type": ["string", "null"] }
      }
    },

    "notes": { "type": "array", "items": { "type": "string" } }
  },

  "$defs": {
    "ref": {
      "type": "object", "required": ["version"], "additionalProperties": false,
      "description": "Con trỏ tới một version. approved và published CHỈ người đặt.",
      "properties": {
        "version": { "type": ["string", "null"], "pattern": "^v[0-9]{3}$" },
        "set_at": { "type": ["string", "null"] },
        "set_by": { "type": ["string", "null"], "description": "'owner' cho approved/published. Agent không được tự đặt." },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
